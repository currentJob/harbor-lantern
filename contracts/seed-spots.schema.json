{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-lantern.local/contracts/seed-spots.schema.json",
  "title": "Harbor Lantern 시드 데이터 계약 (4일 27스팟)",
  "description": "`seed/spots.json` 의 형태를 강제한다. 원본은 `reference/original-static-page.html` 의 `DAYS` 배열이며, 이 스키마는 전사(轉寫) 실수를 로드 시점에 터뜨리는 것이 목적이다(AC-001). 일자 수 4와 일자별 스팟 수 6·9·8·4를 `prefixItems` 로 못박는다. 설계서: DOC-HKG-02 v1.0 §5.3 (DSN-06).",

  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "days"],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "이 계약의 버전. 형태가 바뀌면 올리고 로더가 거부한다."
    },
    "source": {
      "type": "string",
      "const": "reference/original-static-page.html",
      "description": "출처 고정. 값이 다르면 다른 데이터를 넣은 것이다."
    },
    "note": {
      "type": "string",
      "description": "영업시간·휴무는 원본이 밝힌 근사치다(가정 A1). 정확성을 보증하지 않으며 사용자가 편집한다(REQ-004)."
    },
    "days": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "총 27스팟. 일자별 6·9·8·4 (AC-001).",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/day" },
            {
              "properties": {
                "day_index": { "const": 1 },
                "spots": { "minItems": 6, "maxItems": 6 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/day" },
            {
              "properties": {
                "day_index": { "const": 2 },
                "spots": { "minItems": 9, "maxItems": 9 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/day" },
            {
              "properties": {
                "day_index": { "const": 3 },
                "spots": { "minItems": 8, "maxItems": 8 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/day" },
            {
              "properties": {
                "day_index": { "const": 4 },
                "spots": { "minItems": 4, "maxItems": 4 }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },

  "$defs": {

    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_index", "label", "title", "area", "color", "start_local", "spots"],
      "properties": {
        "day_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "원본 `day.d`"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "원본 `day.date` 의 표시 문자열 (예: \"10.5 월\"). 실제 날짜는 `trip.start_date` 에서 계산하므로 이 값은 표시용이다.",
          "examples": ["10.5 월", "10.6 화", "10.7 수", "10.8 목"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "원본 `day.title`"
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "원본 `day.area`"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$",
          "description": "원본 `day.color` (소문자 hex). 다크 네온 테마 토큰 — 회귀 금지(NFR-009).",
          "examples": ["#22d3ee", "#ff2e88", "#f7b733", "#a78bfa"]
        },
        "start_local": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "일자 시작시각 (HKT). 첫 스팟의 시간대 기본 시작시각에서 유도해 **한 번 굳힌 값**이다. 매번 재계산하면 재정렬로 첫 스팟이 바뀔 때 하루 전체가 밀린다. 설계 유도값: Day 1 = 14:00, Day 2~4 = 09:00.",
          "examples": ["14:00", "09:00"]
        },
        "spots": {
          "type": "array",
          "items": { "$ref": "#/$defs/spot" }
        }
      }
    },

    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_label",
        "name",
        "name_original",
        "tip",
        "hours_text",
        "closed_text",
        "description",
        "recommendation",
        "lat",
        "lng"
      ],
      "properties": {
        "time_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "원본 `spot.t`. `HH:MM` 형태이면 고정시각 일정이며 로더가 `fixed_start_local` 을 같은 값으로 유도한다(REQ-013 의 앵커). 그 외에는 시간대 라벨이고 설계서 §6.8 표로 기본 시작시각·체류시간이 결정된다.",
          "examples": ["오전", "점심", "점심후", "오후", "일몰", "이른저녁", "저녁", "야경", "밤", "20:00"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "원본 `spot.n`"
        },
        "name_original": {
          "type": "string",
          "maxLength": 120,
          "description": "원본 `spot.s` (원어명·부제)"
        },
        "tip": {
          "type": "string",
          "maxLength": 500,
          "description": "원본 `spot.tip`"
        },
        "hours_text": {
          "type": "string",
          "maxLength": 200,
          "description": "원본 `spot.hours` **문자열 그대로**. 절대 미리 파싱해서 넣지 않는다 — 파싱은 런타임에 `domain/hours.py` 가 하고, 못 읽으면 `unknown` 이며 경고를 만들지 않는다(AC-024). 값은 근사치다(가정 A1).",
          "examples": [
            "야외 상시 (24h)",
            "매일 08:00–18:00 · 무료",
            "평일 10:00–18:00 / 주말·공휴일 09:00–18:30",
            "단지 상시 · 상점 대략 11:00–20:00",
            "하행 06:00–10:00 / 상행 10:00–24:00"
          ]
        },
        "closed_text": {
          "type": "string",
          "maxLength": 200,
          "description": "원본 `spot.closed` 문자열 그대로. 요일 토큰(`월요일` 등)만 파서가 뽑아 쓰고, 날짜 범위 표기는 해석하지 않는다.",
          "examples": ["", "일부 갤러리 월요일", "(정비휴무 9/8~18은 여행 전 종료)"]
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "원본 `spot.desc`"
        },
        "recommendation": {
          "type": "string",
          "maxLength": 500,
          "description": "원본 `spot.rec`"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "원본 `spot.lat`. **값을 반올림하거나 다시 조사해서 바꾸지 않는다** — AC-034 가 길찾기 URL 의 좌표 일치를 assert 한다."
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "원본 `spot.lng`. 위와 같음."
        },
        "dwell_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 1440,
          "default": null,
          "description": "체류시간(분). 원본에 없는 파생 필드이므로 시드는 전부 null 이고, 런타임에 `time_label` 기반 기본값이 적용된다(설계서 §6.8, O6). AC-021·AC-025 가 체류시간을 입력으로 요구하기 때문에 편집 가능 필드로 존재한다."
        }
      }
    }
  }
}
